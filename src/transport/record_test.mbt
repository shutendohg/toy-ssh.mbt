// chacha20-poly1305@openssh.com record layer (docs/02 section 7).

///|
/// Deterministic 64-byte key whose two 32-byte halves differ, so a swapped
/// K_1/K_2 split shows up in every test that uses it.
fn test_key() -> Bytes {
  Bytes::makei(64, i => (i * 7 + 3).to_byte())
}

///|
/// A fresh AEAD record state on `test_key()`; the suite has no IV and no
/// separate MAC key, so both are empty.
fn chacha_state() -> @transport.RecordState {
  @transport.RecordState::new(ChaCha20Poly1305, {
    iv: b"",
    enc: test_key(),
    mac: b"",
  })
}

///|
test "RecordKey: content key is bytes 0..32, length key is bytes 32..64" {
  let k = @transport.RecordKey::new(test_key()[:])
  assert_eq(k.content, test_key()[0:32].to_owned())
  assert_eq(k.length, test_key()[32:64].to_owned())
  assert_not_eq(k.content, k.length)
}

///|
test "record_nonce: 8 zero bytes then uint32_be(seqnum)" {
  inspect(
    @hex.encode(@transport.record_nonce(0)[:]),
    content="000000000000000000000000",
  )
  inspect(
    @hex.encode(@transport.record_nonce(1)[:]),
    content="000000000000000000000001",
  )
  inspect(
    @hex.encode(@transport.record_nonce(0x01020304)[:]),
    content="000000000000000001020304",
  )
}

///|
test "aead_padding_length: aligns 1 + payload to 8 without the length field" {
  // payload_len -> padding_len, per docs/02 section 7 step 1
  let cases = [
    (0, 7),
    (1, 6),
    (5, 10),
    (6, 9),
    (7, 8),
    (8, 7),
    (11, 4),
    (12, 11),
  ]
  for c in cases {
    let (payload_len, want) = c
    let pad = @transport.aead_padding_length(payload_len)
    assert_eq(pad, want)
    assert_true(pad >= 4)
    assert_eq((1 + payload_len + pad) % 8, 0)
  }
  // The AEAD rule is NOT the plaintext rule: the 4-byte length field is
  // excluded from the alignment, so the two must not be merged.
  let mut differs = false
  for payload_len in 0..<16 {
    if @transport.aead_padding_length(payload_len) !=
      @transport.padding_length(payload_len) {
      differs = true
    }
  }
  assert_true(differs)
}

///|
/// Raw ChaCha20 keystream XORed into `data` (helper for building expected
/// values and bogus ciphertext by hand in tests).
fn chacha_xor(
  key : BytesView,
  nonce : Bytes,
  counter : UInt,
  data : Bytes,
) -> Bytes raise {
  let c = @xcrypto.ChaCha::chacha20(key, nonce, counter~)
  let out = FixedArray::make(data.length(), b'\x00')
  c.transform(data, out)
  @crypto.fixed_to_bytes(out)
}

///|
test "seal_packet: byte-exact fixture for zero key, seqnum 0, empty payload" {
  // Generated by this implementation and cross-checked against a pure-Python
  // ChaCha20/Poly1305 reference (RFC 8439 vectors verified). NOT yet checked
  // against OpenSSH itself: the M2 interop test (docs/06 step 5) does that.
  let key = @transport.RecordKey::new(Bytes::make(64, b'\x00')[:])
  let pkt = @transport.seal_packet(key, 0, b""[:], fill=@transport.zero_padding)
  inspect(
    @hex.encode(pkt[:]),
    content="76b8e0a5" + "9807e7be5551387a" + "dd4f1a4236d424c53b462f9bc9369dc2",
  )
}

///|
test "seal_packet: length field is encrypted with K_1 = key[32..64], counter 0" {
  let key64 = test_key()
  let key = @transport.RecordKey::new(key64[:])
  let pkt = @transport.seal_packet(
    key,
    5,
    b"abc"[:],
    fill=@transport.zero_padding,
  )
  // 1 + 3 = 4 -> pad 4 -> packet_length 8; total 4 + 8 + 16
  assert_eq(pkt.length(), 4 + 8 + 16)
  let want_len = chacha_xor(
    key64[32:64],
    @transport.record_nonce(5),
    0,
    b"\x00\x00\x00\x08",
  )
  assert_eq(pkt[0:4].to_owned(), want_len)
  // and NOT with the content key
  let wrong = chacha_xor(
    key64[0:32],
    @transport.record_nonce(5),
    0,
    b"\x00\x00\x00\x08",
  )
  assert_not_eq(pkt[0:4].to_owned(), wrong)
  // body uses K_2 with counter 1 (counter 0 is the Poly1305 key block)
  let want_body = chacha_xor(
    key64[0:32],
    @transport.record_nonce(5),
    1,
    b"\x04abc\x00\x00\x00\x00",
  )
  assert_eq(pkt[4:12].to_owned(), want_body)
}

///|
test "seal_packet: refuses a packet whose total size would exceed 35000" {
  // payload 34992 -> 1 + 34992 = 34993 -> pad 7 -> 4 + 35000 > 35000
  let key = @transport.RecordKey::new(test_key()[:])
  let payload = Bytes::make(34992, b'\x5a')
  try
    @transport.seal_packet(key, 0, payload[:], fill=@transport.zero_padding)
  catch {
    e => debug_inspect(e, content="ProtocolError(\"packet too large\")")
  } noraise {
    _ => fail("expected seal_packet to raise")
  }
  // payload 34991 -> 34992 -> pad 8 -> 4 + 35000 = 35004 > 35000: also refused
  let payload2 = Bytes::make(34991, b'\x5a')
  try
    @transport.seal_packet(key, 0, payload2[:], fill=@transport.zero_padding)
  catch {
    e => debug_inspect(e, content="ProtocolError(\"packet too large\")")
  } noraise {
    _ => fail("expected seal_packet to raise")
  }
  // payload 34987 -> 34988 -> pad 4 -> packet_length 34992 -> total 34996 (tag excluded): ok
  let payload3 = Bytes::make(34987, b'\x5a')
  let pkt = @transport.seal_packet(
    key,
    0,
    payload3[:],
    fill=@transport.zero_padding,
  )
  assert_eq(pkt.length(), 4 + 34992 + 16)
}

///|
/// Open `buf` under `key`/`seqnum`, expecting exactly one complete packet.
fn open_ok(
  key : @transport.RecordKey,
  seqnum : UInt,
  buf : BytesView,
) -> (Bytes, Int) raise {
  match @transport.open_packet(key, seqnum, buf) {
    Packet(payload~, consumed~) => (payload, consumed)
    NeedMoreData => fail("complete packet reported as incomplete")
  }
}

///|
/// Open `buf` under `key`/`seqnum`, expecting a `ProtocolError` whose
/// debug form is `want`.
fn open_err(
  key : @transport.RecordKey,
  seqnum : UInt,
  buf : BytesView,
  want : String,
) -> Unit raise {
  try @transport.open_packet(key, seqnum, buf) catch {
    e => debug_inspect(e, content=want)
  } noraise {
    _ => fail("expected open_packet to raise")
  }
}

///|
/// Open `buf` expecting SOME `ProtocolError`. Used where the peer's
/// garbage length may be rejected before the tag is ever checked.
fn open_rejected(
  key : @transport.RecordKey,
  seqnum : UInt,
  buf : BytesView,
) -> Unit raise {
  try @transport.open_packet(key, seqnum, buf) catch {
    ProtocolError(msg) =>
      assert_true(
        msg == "MAC/tag verification failed" ||
        msg == "packet too large" ||
        msg == "packet too small" ||
        msg == "packet not aligned",
      )
  } noraise {
    _ => fail("expected open_packet to raise")
  }
}

///|
/// Re-encrypt `pkt`'s length field so it decrypts correctly under
/// `key`/`seqnum`, leaving body and tag as they were. Forces a packet
/// sealed under other parameters past the length sanity check so the
/// failure has to come from the tag.
fn relabel_length(
  from_key : Bytes,
  from_seq : UInt,
  to_key : Bytes,
  to_seq : UInt,
  pkt : Bytes,
) -> Bytes raise {
  let plain_len = chacha_xor(
    from_key[32:64],
    @transport.record_nonce(from_seq),
    0,
    pkt[0:4].to_owned(),
  )
  let new_len = chacha_xor(
    to_key[32:64],
    @transport.record_nonce(to_seq),
    0,
    plain_len,
  )
  new_len + pkt[4:].to_owned()
}

///|
test "open_packet: round-trips payloads of every alignment" {
  let key = @transport.RecordKey::new(test_key()[:])
  for n in [0, 1, 5, 6, 7, 8, 100, 1000] {
    let payload = Bytes::makei(n, i => (i % 251).to_byte())
    let pkt = @transport.seal_packet(
      key,
      7,
      payload[:],
      fill=@transport.zero_padding,
    )
    assert_eq((pkt.length() - 4 - 16) % 8, 0)
    let (got, consumed) = open_ok(key, 7, pkt[:])
    assert_eq(got, payload)
    assert_eq(consumed, pkt.length())
  }
}

///|
test "open_packet: consumes one packet; the next one needs the next seqnum" {
  let key = @transport.RecordKey::new(test_key()[:])
  let p0 = @transport.seal_packet(
    key,
    0,
    b"first"[:],
    fill=@transport.zero_padding,
  )
  let p1 = @transport.seal_packet(
    key,
    1,
    b"second"[:],
    fill=@transport.zero_padding,
  )
  let stream = p0 + p1
  let (got0, consumed0) = open_ok(key, 0, stream[:])
  assert_eq(got0, b"first")
  assert_eq(consumed0, p0.length())
  let (got1, consumed1) = open_ok(key, 1, stream[consumed0:])
  assert_eq(got1, b"second")
  assert_eq(consumed1, p1.length())
  // Same key, wrong seqnum: the nonce differs. The length field decrypts
  // to garbage first, so rejection may come from the length sanity check.
  open_rejected(key, 1, stream[:])
  open_rejected(key, 0, stream[consumed0:])
  // With the length field relabelled to seqnum 1, p0 gets past the length
  // check and must then fail on the tag (nonce mismatch in body/poly key).
  let relabelled = relabel_length(test_key(), 0, test_key(), 1, p0)
  open_err(
    key,
    1,
    relabelled[:],
    "ProtocolError(\"MAC/tag verification failed\")",
  )
}

///|
test "open_packet: sealing with key A and opening with key B fails at the tag" {
  let key_a = @transport.RecordKey::new(test_key()[:])
  let key_b_bytes = Bytes::makei(64, i => (i * 13 + 1).to_byte())
  let key_b = @transport.RecordKey::new(key_b_bytes[:])
  let pkt = @transport.seal_packet(
    key_a,
    0,
    b"hello"[:],
    fill=@transport.zero_padding,
  )
  open_rejected(key_b, 0, pkt[:])
  // Relabel the length under key B so only the body/tag keys disagree.
  let relabelled = relabel_length(test_key(), 0, key_b_bytes, 0, pkt)
  open_err(
    key_b,
    0,
    relabelled[:],
    "ProtocolError(\"MAC/tag verification failed\")",
  )
}

///|
test "open_packet: any single flipped bit in enc_len, enc_body or tag is rejected" {
  let key = @transport.RecordKey::new(test_key()[:])
  let pkt = @transport.seal_packet(
    key,
    3,
    b"hello"[:],
    fill=@transport.zero_padding,
  )
  // 1 + 5 = 6 -> pad 2 < 4 -> pad 10 -> packet_length 16;
  // 4 (len) + 16 (body) + 16 (tag) = 36 bytes
  assert_eq(pkt.length(), 36)
  let positions = [0, 3, 4, 5, 19, 20, 28, 35]
  for pos in positions {
    for bit in [0, 3, 7] {
      let mutated = Bytes::makei(pkt.length(), i => {
        if i == pos {
          pkt[i] ^ (1 << bit).to_byte()
        } else {
          pkt[i]
        }
      })
      // A flipped length byte may decrypt to an absurd length and be
      // rejected as too large/small first; anything else must fail on the
      // tag. Either way it must never yield a payload.
      try @transport.open_packet(key, 3, mutated[:]) catch {
        ProtocolError(msg) =>
          if pos >= 4 {
            assert_eq(msg, "MAC/tag verification failed")
          } else {
            assert_true(
              msg == "MAC/tag verification failed" ||
              msg == "packet too large" ||
              msg == "packet too small" ||
              msg == "packet not aligned",
            )
          }
      } noraise {
        Packet(..) => fail("corrupted packet was accepted")
        // A flipped length byte can also make the packet look longer than
        // the buffer; that is a NeedMoreData, not an acceptance.
        NeedMoreData => assert_true(pos < 4)
      }
    }
  }
}

///|
test "open_packet: reports NeedMoreData for partial input" {
  let key = @transport.RecordKey::new(test_key()[:])
  let pkt = @transport.seal_packet(
    key,
    0,
    b"hello"[:],
    fill=@transport.zero_padding,
  )
  debug_inspect(
    @transport.open_packet(key, 0, pkt[0:0]),
    content="NeedMoreData",
  )
  debug_inspect(
    @transport.open_packet(key, 0, pkt[0:3]),
    content="NeedMoreData",
  )
  debug_inspect(
    @transport.open_packet(key, 0, pkt[0:4]),
    content="NeedMoreData",
  )
  debug_inspect(
    @transport.open_packet(key, 0, pkt[0:pkt.length() - 1]),
    content="NeedMoreData",
  )
}

///|
test "open_packet: rejects an absurd decrypted length before asking for more bytes" {
  let key64 = test_key()
  let key = @transport.RecordKey::new(key64[:])
  fn bogus(seqnum : UInt, packet_length : Bytes) -> Bytes raise {
    chacha_xor(key64[32:64], @transport.record_nonce(seqnum), 0, packet_length)
  }
  // 34997 + 4 = 35001 > 35000
  open_err(
    key,
    0,
    bogus(0, b"\x00\x00\x88\xb5")[:],
    "ProtocolError(\"packet too large\")",
  )
  // top bit set must not wrap negative
  open_err(
    key,
    0,
    bogus(0, b"\xff\xff\xff\xff")[:],
    "ProtocolError(\"packet too large\")",
  )
  open_err(
    key,
    0,
    bogus(0, b"\x80\x00\x00\x08")[:],
    "ProtocolError(\"packet too large\")",
  )
  // packet_length < 5 cannot hold padding_length + 4 padding bytes
  open_err(
    key,
    0,
    bogus(0, b"\x00\x00\x00\x04")[:],
    "ProtocolError(\"packet too small\")",
  )
  open_err(
    key,
    0,
    bogus(0, b"\x00\x00\x00\x00")[:],
    "ProtocolError(\"packet too small\")",
  )
  // packet_length not a multiple of 8
  open_err(
    key,
    9,
    bogus(9, b"\x00\x00\x00\x0d")[:],
    "ProtocolError(\"packet not aligned\")",
  )
  // Largest acceptable length only asks for more bytes: 34992 + 4 = 34996
  debug_inspect(
    @transport.open_packet(key, 0, bogus(0, b"\x00\x00\x88\xb0")[:]),
    content="NeedMoreData",
  )
}

///|
test "open_packet: rejects bad padding_length inside an authenticated body" {
  // Build a well-tagged packet by hand whose plaintext padding_length is
  // illegal, so the check has to happen after the tag verifies.
  let key64 = test_key()
  let key = @transport.RecordKey::new(key64[:])
  fn forge(seqnum : UInt, body : Bytes) -> Bytes raise {
    let nonce = @transport.record_nonce(seqnum)
    let len = @wire.Writer::new()
    len.write_uint32(body.length().reinterpret_as_uint())
    let enc_len = chacha_xor(key64[32:64], nonce, 0, len.to_bytes())
    let pk = chacha_xor(key64[0:32], nonce, 0, Bytes::make(32, b'\x00'))
    let enc_body = chacha_xor(key64[0:32], nonce, 1, body)
    let authed = enc_len + enc_body
    let tag = @crypto.poly1305(pk[:], authed[:])
    authed + @crypto.fixed_to_bytes(tag)
  }
  // padding_length 3 < 4
  open_err(
    key,
    2,
    forge(2, b"\x03abcd\x00\x00\x00")[:],
    "ProtocolError(\"padding too short\")",
  )
  // padding_length 8 > packet_length - 1 = 7
  open_err(
    key,
    2,
    forge(2, b"\x08\x00\x00\x00\x00\x00\x00\x00")[:],
    "ProtocolError(\"padding exceeds packet\")",
  )
  // and the forge helper itself is sound: a legal body opens
  let (got, _) = open_ok(key, 2, forge(2, b"\x04abc\x00\x00\x00\x00")[:])
  assert_eq(got, b"abc")
}

///|
test "RecordState: seq advances per packet and wraps mod 2^32" {
  let tx = chacha_state()
  let rx = chacha_state()
  assert_eq(tx.seq, 0)
  let p0 = tx.seal_next(b"one"[:], fill=@transport.zero_padding)
  assert_eq(tx.seq, 1)
  let p1 = tx.seal_next(b"two"[:], fill=@transport.zero_padding)
  assert_eq(tx.seq, 2)
  // Stateless equivalents agree on the numbering.
  let key = @transport.RecordKey::new(test_key()[:])
  assert_eq(
    p0,
    @transport.seal_packet(key, 0, b"one"[:], fill=@transport.zero_padding),
  )
  assert_eq(
    p1,
    @transport.seal_packet(key, 1, b"two"[:], fill=@transport.zero_padding),
  )
  let stream = p0 + p1
  match rx.open_next(stream[:]) {
    Packet(payload~, consumed~) => {
      assert_eq(payload, b"one")
      assert_eq(rx.seq, 1)
      match rx.open_next(stream[consumed:]) {
        Packet(payload~, ..) => assert_eq(payload, b"two")
        NeedMoreData => fail("second packet incomplete")
      }
    }
    NeedMoreData => fail("first packet incomplete")
  }
  assert_eq(rx.seq, 2)
  // Wrap-around: 0xffffffff + 1 == 0 (UInt arithmetic).
  let wrap = chacha_state()
  wrap.seq = 0xffffffffU
  ignore(wrap.seal_next(b""[:], fill=@transport.zero_padding))
  assert_eq(wrap.seq, 0)
}

///|
test "RecordState: NeedMoreData and a failed open do not advance seq" {
  let tx = chacha_state()
  let rx = chacha_state()
  let pkt = tx.seal_next(b"hello"[:], fill=@transport.zero_padding)
  debug_inspect(rx.open_next(pkt[0:pkt.length() - 1]), content="NeedMoreData")
  assert_eq(rx.seq, 0)
  // Corrupt the tag: rejected, seq still 0.
  let bad = Bytes::makei(pkt.length(), i => {
    if i == pkt.length() - 1 {
      pkt[i] ^ b'\x01'
    } else {
      pkt[i]
    }
  })
  try rx.open_next(bad[:]) catch {
    e =>
      debug_inspect(e, content="ProtocolError(\"MAC/tag verification failed\")")
  } noraise {
    _ => fail("expected open_next to raise")
  }
  assert_eq(rx.seq, 0)
  // The intact packet still opens under seq 0 afterwards.
  match rx.open_next(pkt[:]) {
    Packet(payload~, ..) => assert_eq(payload, b"hello")
    NeedMoreData => fail("complete packet reported as incomplete")
  }
  assert_eq(rx.seq, 1)
}
